# ===========================================
# CONFIGURACIÓN DEL FRONTEND - SISTEMA SGGS
# ===========================================
# Este archivo contiene las variables de entorno para el frontend React + Vite
# Copiar este archivo como .env y completar con los valores reales

# ===========================================
# IMPORTANTE - VITE
# ===========================================
# En Vite, todas las variables de entorno expuestas al cliente
# DEBEN empezar con el prefijo VITE_
# Ejemplo: VITE_API_URL en lugar de solo API_URL

# ===========================================
# URL DE LA API BACKEND
# ===========================================
# URL base del backend para todas las peticiones HTTP
# Desarrollo: http://localhost:3000/api/v1
# Producción: https://tu-dominio.com/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# ===========================================
# URL DEL FRONTEND
# ===========================================
# URL donde está desplegado el frontend
# Usado para redirecciones y links absolutos
# Desarrollo: http://localhost:5173
# Producción: https://tu-dominio-frontend.com
VITE_FRONTEND_URL=http://localhost:5173

# ===========================================
# NOTAS IMPORTANTES
# ===========================================
# 1. Nunca subir el archivo .env al repositorio (debe estar en .gitignore)
# 2. En producción, configurar estas variables en el servidor/hosting
# 3. Vite requiere el prefijo VITE_ para exponer al cliente
# 4. Acceder a las variables con: import.meta.env.VITE_NOMBRE_VARIABLE
# 5. Después de cambiar .env, reiniciar el servidor de desarrollo (npm run dev)
