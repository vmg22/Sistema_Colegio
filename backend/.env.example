# ===========================================
# CONFIGURACIÓN DEL SISTEMA ESCOLAR SGGS
# ===========================================
# Este archivo contiene todas las variables de entorno necesarias
# Copiar este archivo como .env y completar con los valores reales

# ===========================================
# BASE DE DATOS - MySQL
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ndt782a2
DB_NAME=sggs

# ===========================================
# AUTENTICACIÓN Y SEGURIDAD
# ===========================================
# Secret para firmar los tokens JWT (debe ser una cadena aleatoria y segura)
JWT_SECRET=tu_secreto_super_seguro_minimo_32_caracteres_aleatorios
JWT_EXPIRES_IN=24h

# ===========================================
# CONFIGURACIÓN DE EMAIL (Nodemailer)
# ===========================================
# Para Gmail, usar: smtp.gmail.com y puerto 587
# Para otros proveedores, consultar su documentación
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=omegasuprime2585@gmail.com
EMAIL_PASS=vuyezmygogvkmpdj

# ===========================================
# URLs DE LA APLICACIÓN
# ===========================================
# URL del frontend (usado para CORS y links en emails)
FRONTEND_URL=http://localhost:5173

# URL del backend (usado para logging y referencias)
BACKEND_URL=http://localhost:3000

# ===========================================
# CONFIGURACIÓN DEL SERVIDOR
# ===========================================
# Entorno de ejecución: development, production, test
NODE_ENV=development

# Puerto en el que correrá el servidor
PORT=3000

# ===========================================
# NOTAS IMPORTANTES
# ===========================================
# 1. Nunca subir el archivo .env al repositorio (debe estar en .gitignore)
# 2. En producción, usar variables de entorno del servidor/hosting
# 3. El JWT_SECRET debe ser diferente en desarrollo y producción
# 4. Para Gmail, habilitar "Acceso de aplicaciones menos seguras" o usar "Contraseñas de aplicación"
